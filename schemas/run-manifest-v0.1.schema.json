{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/patchalign/run-manifest-v0.1.schema.json",
  "title": "PatchAlign run manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "started_at",
    "git_commit",
    "dirty_worktree",
    "config_sha256",
    "model_id",
    "model_revision",
    "model_config_sha256",
    "dataset_manifest_sha256",
    "environment_sha256",
    "seed",
    "slurm_job_id",
    "prediction_artifact_sha256",
    "execution_artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["g0", "baseline", "sft_pilot", "sft", "preference_generation", "dpo_pilot", "dpo", "evaluation"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty_worktree": {"type": "boolean"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": ["string", "null"]},
    "model_config_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "dataset_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "seed": {"type": "integer", "minimum": 0},
    "slurm_job_id": {"type": ["string", "null"], "pattern": "^[0-9]+(?:_[0-9]+)?$"},
    "prediction_artifact_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "execution_artifact_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
