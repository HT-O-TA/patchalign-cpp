{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchalign.local/schemas/a4-preference-candidate-v0.1.schema.json",
  "title": "PatchAlign A4 preference candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "candidate_id", "case_id",
    "source_train_sample_id", "task_level", "model", "prompt_version",
    "prompt_sha256", "seed", "candidate_index", "generation", "raw_text",
    "extracted_patch", "status", "error", "input_tokens", "output_tokens",
    "latency_seconds", "max_gpu_memory_bytes"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "source_train_sample_id": {"type": "string", "minLength": 1},
    "task_level": {"enum": ["function", "file_window"]},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "config_sha256", "adapter_sha256"],
      "properties": {
        "model_id": {"type": "string"},
        "revision": {"type": "string"},
        "config_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "adapter_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "prompt_version": {"const": "a4-cpp-repair-v1"},
    "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "seed": {"type": "integer", "minimum": 0},
    "candidate_index": {"type": "integer", "minimum": 0, "maximum": 3},
    "generation": {"type": "object"},
    "raw_text": {"type": "string"},
    "extracted_patch": {"type": ["string", "null"]},
    "status": {"enum": ["ok", "oom", "generation_failed"]},
    "error": {"type": ["string", "null"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "latency_seconds": {"type": "number", "minimum": 0},
    "max_gpu_memory_bytes": {"type": "integer", "minimum": 0}
  }
}
