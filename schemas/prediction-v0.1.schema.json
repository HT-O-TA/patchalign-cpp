{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/patchalign/prediction-v0.1.schema.json",
  "title": "PatchAlign prediction record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "sample_id",
    "model",
    "prompt_version",
    "prompt_sha256",
    "seed",
    "generation",
    "raw_text",
    "extracted_patch",
    "status",
    "input_tokens",
    "output_tokens",
    "latency_seconds"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "config_sha256", "adapter_sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "seed": {"type": "integer", "minimum": 0},
    "generation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["do_sample", "max_new_tokens"],
      "properties": {
        "do_sample": {"type": "boolean"},
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "top_p": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "raw_text": {"type": "string"},
    "extracted_patch": {"type": ["string", "null"]},
    "status": {"enum": ["ok", "generation_failed", "timeout", "oom"]},
    "error": {"type": ["string", "null"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "latency_seconds": {"type": "number", "minimum": 0},
    "max_gpu_memory_bytes": {"type": ["integer", "null"], "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
